# =============================================================================
# Web3 SecOps Lab — 环境配置示例（EXAMPLE）
# 复制为 `.env` 后按需修改。真实的 `.env` 不要提交到 Git。
# =============================================================================
#
# 说明：第一周（Week 1）程序只用到下面两个配置项。
# 链上 RPC 地址等配置属于 Week 2，等真正实现了再添加。

# 应用名称（会出现在结构化日志里）
APP_NAME=web3-secops-lab

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
