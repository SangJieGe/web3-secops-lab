# =============================================================================
# Web3 SecOps Lab — configuration example
# Copy to `.env` and fill in. Never commit a real `.env`.
#
# The real `.env` is git-ignored. This file must never contain a real key.
# =============================================================================

# --- RPC ---------------------------------------------------------------------
# HTTP(S) endpoint of an Ethereum JSON-RPC provider.
# https:// is strongly recommended; http:// sends the key in clear text and
# produces a warning at startup.
#
# Do NOT commit a URL containing an API key. Use a placeholder here, and put the
# real value only in your local `.env`.
#
# Synthetic example (not a working endpoint):
ETHEREUM_RPC_URL=https://eth-mainnet.example.org/v2/YOUR_API_KEY_HERE

# Expected chain id. The program refuses to scan if the node reports anything
# else, which prevents mixing two networks into one database.
#   1        Ethereum mainnet
#   11155111 Sepolia testnet   <- use a testnet while developing
EXPECTED_CHAIN_ID=11155111

# --- RPC resilience ----------------------------------------------------------
# Per-request timeout in seconds (connect + read).
RPC_TIMEOUT_SECONDS=20
# Retries for transient failures (HTTP 408/429/5xx, timeouts, node-side errors).
# 3 means up to 4 attempts total. Set to 0 to disable retrying.
RPC_MAX_RETRIES=3

# --- Scan window -------------------------------------------------------------
# Stay this many blocks behind the chain head so short reorgs are not scanned
# as if they were final.
CONFIRMATIONS=12

# Blocks scanned per --once invocation / per watch iteration.
BLOCK_BATCH_SIZE=5

# On a cold start with no cursor, begin this many blocks behind the safe head.
START_BLOCK_LOOKBACK=20

# Fixed first block instead of the lookback above. Leave empty to use lookback.
START_BLOCK=

# Seconds to sleep between polling iterations in --watch mode.
POLL_INTERVAL_SECONDS=12

# --- Reorg handling ----------------------------------------------------------
# How many recent block hashes are kept to detect reorgs and find a common
# ancestor. A reorg deeper than this stops the scanner with an error rather than
# silently skipping history.
REORG_WINDOW=64

# --- Storage -----------------------------------------------------------------
# SQLite file holding the cursor and recent block hashes. The parent directory
# is created automatically and the file is chmod 0600 on first write.
STATE_DB_PATH=./data/state.db

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
