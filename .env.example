# =============================================================================
# Web3 SecOps Lab — Environment Configuration (EXAMPLE)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

# ---- RPC endpoints (read-only, public nodes are fine for polling) ----
# Use a dedicated/paid provider in production for rate limits + reliability.
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Optional: private/authenticated RPC (Alchemy, Infura, QuickNode, ...)
# ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<API_KEY>

# ---- Chain / scan settings ----
CHAIN_ID=1
# How many blocks to look back on first start (cold start window)
START_BLOCK_LOOKBACK=100
# Poll interval in seconds between scan cycles
POLL_INTERVAL_SECONDS=12
# Max blocks processed concurrently per batch
BLOCK_BATCH_SIZE=5

# ---- Detector thresholds ----
# Minimum value (in native token) for a transfer to be considered notable
MIN_NOTABLE_VALUE=10
# Emit alerts when a watched address interacts with a flagged contract
FLAG_ON_WATCHED_INTERACTION=true

# ---- Alerting (Wazuh integration) ----
# File channel: append JSON alerts here; wazuh agent tails this file
ALERT_LOG_PATH=./logs/alerts.jsonl
# Optional webhook (leave empty to disable)
ALERT_WEBHOOK_URL=
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Storage ----
# SQLite file used to persist scan cursor + dedup state
STATE_DB_PATH=./data/state.db
