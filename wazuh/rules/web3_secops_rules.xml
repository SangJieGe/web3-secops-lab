# Wazuh rules for Web3 SecOps Lab
#
# Install to: /var/ossec/etc/rules/web3_secops_rules.xml
# Then restart the manager: systemctl restart wazuh-manager
#
# Rule ID range 100100-100199 is reserved for this lab.

<group name="web3_secops,">
  <!-- Base catch-all: any web3-secops alert -->
  <rule id="100100" level="5">
    <decoded_as>web3-secops</decoded_as>
    <description>Web3 SecOps: alert received</description>
  </rule>

  <!-- Severity escalation -->
  <rule id="100101" level="8">
    <if_sid>100100</if_sid>
    <field name="rule.severity">^medium$</field>
    <description>Web3 SecOps [MEDIUM]: $(rule.title)</description>
  </rule>

  <rule id="100102" level="10">
    <if_sid>100100</if_sid>
    <field name="rule.severity">^high$</field>
    <description>Web3 SecOps [HIGH]: $(rule.title)</description>
  </rule>

  <rule id="100103" level="12">
    <if_sid>100100</if_sid>
    <field name="rule.severity">^critical$</field>
    <description>Web3 SecOps [CRITICAL]: $(rule.title)</description>
    <mitre>
      <id>T1567</id>
    </mitre>
  </rule>

  <!-- Rule-specific overrides -->
  <rule id="100110" level="13">
    <if_sid>100100</if_sid>
    <field name="rule.id">^rapid-drain$</field>
    <description>Web3 SecOps: RAPID DRAIN detected on $(web3.address)</description>
    <mitre>
      <id>T1531</id>
    </mitre>
  </rule>

  <rule id="100111" level="12">
    <if_sid>100100</if_sid>
    <field name="rule.id">^flagged-interaction$</field>
    <description>Web3 SecOps: interaction with flagged contract $(web3.address)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

  <rule id="100112" level="10">
    <if_sid>100100</if_sid>
    <field name="rule.id">^watched-(outbound|inbound)$</field>
    <description>Web3 SecOps: watched address activity $(web3.address)</description>
  </rule>

  <rule id="100113" level="8">
    <if_sid>100100</if_sid>
    <field name="rule.id">^large-transfer$</field>
    <description>Web3 SecOps: large native transfer $(web3.tx_hash)</description>
  </rule>
</group>
